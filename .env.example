# Database. Leave as-is for embedded Postgres (PGlite) stored in ./.data,
# or point to Neon/Supabase/any Postgres 16+: postgres://user:pass@host/db
DATABASE_URL=pglite:./.data/pglite

APP_URL=http://localhost:3000

# openssl rand -base64 32
BETTER_AUTH_SECRET=
# openssl rand -base64 32 (encrypts connection credentials at rest)
ENCRYPTION_KEY=

# Optional: Google OAuth client (login + Gmail/Calendar connections).
# Authorized redirect URIs:
#   {APP_URL}/api/auth/callback/google
#   {APP_URL}/api/connections/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Scheduler secret: GET /api/cron/release-deferred with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

